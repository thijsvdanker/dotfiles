# Secrets file - Copy this to ~/.secrets and fill in your actual values
# This file should NOT be committed to version control
#
# Usage: cp .secrets.example ~/.secrets && chmod 600 ~/.secrets

# OpenAI / GitHub Copilot API Key
export OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic API Key
export ANTHROPIC_API_KEY="your-anthropic-api-key-here"
