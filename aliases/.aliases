}

function phpunitc {
	xdebug-disable
	./vendor/bin/phpunit --testsuite="CI Tests" "$@"
	xdebug-restore
}

function phpus {
	xdebug-disable
	./vendor/bin/phpunit  --order-by=defects --stop-on-defect "$@"
	xdebug-restore
}

function phplint {
  php vendor/bin/parallel-lint --exclude vendor --exclude _ide_helper.php .
  php vendor/bin/phpmd app/ text phpmd.xml
  php vendor/bin/phpcs --standard=psr2 app
}

function zipdiffmaster {
  git diff --name-only $1 origin/master | zip dest.zip -@
}

function zipdiffdev {
  CURRENT_BRANCH=$(git branch --show-current)
  git diff --name-only ${CURRENT_BRANCH} $(git merge-base ${CURRENT_BRANCH} origin/development) | zip dest.zip -@
}

function zipdiff {
  git diff --name-only HEAD~$1 HEAD | zip dest.zip -@
}

function zipdifftag {
  git diff --name-only $1 HEAD | zip dest.zip -@
}

function zipdifflast {
  git diff --name-only HEAD HEAD^1 | zip dest.zip -@
}

function zipdiffcommit {
  git diff --name-only $1 $1^1 | zip $1.zip -@
}

function zipdiffcommittodev {
  git fetch
  git diff --name-only $1 origin/development | zip $1.zip -@
}

function zipdiffupstream {
  CURRENT_BRANCH=$(git branch --show-current)
  git fetch
  git diff --name-only $1 origin/${CURRENT_BRANCH} | zip $1.zip -@
}

function zipdiffbranchmaster {
  git fetch
  git diff --name-only $1 origin/master | zip dest.zip -@
}

function zipdiffbranchdev {
  git fetch
  git diff --name-only $1 origin/development | zip dest.zip -@
}

function hotfix {
  echo "lets fix it like it's hot 🔥🔥🔥"

  BRANCH_MASTER=$(git branch --show-current)
  BRANCH_DEV=${BRANCH_MASTER}-dev

  git push --set-upstream origin ${BRANCH_MASTER} -o merge_request.create -o merge_request.target=master -o merge_request.remove_source_branch -o merge_request.assign=me -o merge_request.merge_when_pipeline_succeeds
  rll
  git checkout development
  git pull
  git checkout -b ${BRANCH_DEV}
  git cherry-pick $(git rev-parse ${BRANCH_MASTER})
  git push --set-upstream origin ${BRANCH_DEV} -o merge_request.create -o merge_request.target=development -o merge_request.remove_source_branch -o merge_request.assign=me -o merge_request.merge_when_pipeline_succeeds

  echo "All done, we're cool now 😎"
}

function gpmrm {
  BRANCH_MASTER=$(git branch --show-current)

  git push --set-upstream origin ${BRANCH_MASTER} -o merge_request.create -o merge_request.target=master -o merge_request.remove_source_branch -o merge_request.assign=me
  rll

  echo "All done, we're cool now 😎"
}

function gpmrd {
  BRANCH_MASTER=$(git branch --show-current)

  git push --set-upstream origin ${BRANCH_MASTER} -o merge_request.create -o merge_request.target=development -o merge_request.remove_source_branch -o merge_request.assign=me
  rll

  echo "All done, we're cool now 😎"
}

function php80 {
  export PATH="/usr/local/opt/php@8.0/bin:$PATH"
  valet use php@8.0 --force
}

function clc {
    git show --oneline | head -1 | awk '{ print $1 }' | pbcopy
}

function clco {
    COLOR_GREEN="\033[0;32m"
    COLOR_RESET="\033[0m"
    [[ -z $1 ]] && BRANCH=$(git rev-parse --abbrev-ref HEAD) || BRANCH=$1
    LAST_COMMIT_SHA=$(git rev-parse $BRANCH | tail -n 1)
    echo "$LAST_COMMIT_SHA" | tr -d '\n' | pbcopy
    echo "Copied ${COLOR_GREEN}${LAST_COMMIT_SHA} ${COLOR_RESET}from ${BRANCH}."
}

alias todo="nvim ~/Dropbox/notes/@adsysco\ todo.txt"

function rll {
 zipdifflast
 SHA=$(git rev-parse --short HEAD)
 TARGET_DIR=~/Documents/AdSysCo/Builds/2\ -\ releases/$(git_current_branch)-${SHA}
 mkdir -p ${TARGET_DIR}
 mv dest.zip ${TARGET_DIR}
 cd ${TARGET_DIR}
 unzip dest.zip
 rm dest.zip
 cd -
}

function rlt {
 zipdifftag $1
 SHA=$(git rev-parse --short HEAD)
 TARGET_DIR=~/Documents/AdSysCo/Builds/2\ -\ releases/$(git_current_branch)-${SHA}
 mkdir ${TARGET_DIR}
 mv dest.zip ${TARGET_DIR}
 cd ${TARGET_DIR}
 unzip dest.zip
 rm dest.zip
 cd -
}

function rld {
 zipdiffdev
 SHA=$(git rev-parse --short HEAD)
 TARGET_DIR=~/documents/adsysco/builds/2\ -\ releases/$(git_current_branch)-${SHA}
 mkdir -p ${TARGET_DIR}
 mv dest.zip ${TARGET_DIR}
 cd ${TARGET_DIR}
 unzip dest.zip
 rm dest.zip
 cd -
}

function rlm {
 CURRENT_BRANCH=$(git branch --show-current)

 zipdiffmaster
 SHA=$(git rev-parse --short HEAD)
 target_dir=~/Documents/AdSysCo/Builds/2\ -\ releases/$(git_current_branch)-${SHA}
 mkdir -p ${target_dir}
 mv dest.zip ${target_dir}
 cd ${target_dir}
 unzip dest.zip
 rm dest.zip
 cd -

 git checkout master
 zipdiffbranchmaster ${CURRENT_BRANCH}
 target_dir=~/Documents/AdSysCo/Builds/2\ -\ releases/${CURRENT_BRANCH}-${SHA}-revert
 mkdir -p ${target_dir}
 mv dest.zip ${target_dir}
 cd ${target_dir}
 unzip dest.zip
 rm dest.zip
 cd -

 git checkout ${CURRENT_BRANCH}
}

function rlc {
 zipdiffcommit $1
 target_dir=~/documents/adsysco/builds/2\ -\ releases/$1
 mkdir -p ${target_dir}
 mv $1.zip ${target_dir}
 cd ${target_dir}
 unzip $1.zip
 rm $1.zip
 cd -
}

function rlcd {
 zipdiffcommittodev $1
 target_dir=~/documents/adsysco/builds/2\ -\ releases/$1
 mkdir ${target_dir}
 mv $1.zip ${target_dir}
 cd ${target_dir}
 unzip $1.zip
 rm $1.zip
 cd -
}

function rlu {
 CURRENT_BRANCH=$(git branch --show-current)
 zipdiffupstream ${CURRENT_BRANCH}
 SHA=$(git rev-parse --short HEAD)
 target_dir=~/documents/adsysco/builds/2\ -\ releases/${CURRENT_BRANCH}-${SHA}
 mkdir ${target_dir}
 mv ${CURRENT_BRANCH}.zip ${target_dir}
 cd ${target_dir}
 unzip ${CURRENT_BRANCH}.zip
 rm ${CURRENT_BRANCH}.zip
 cd -
}

function devintomaster {
    git checkout master
    git pull
    git checkout development
    git pull
    SHA=$(git rev-parse --short HEAD)
    git checkout -b dev-into-master-${SHA}
    git merge -s ours master
    git push
}

function giturl {
    HTTPS_URL="https://git.adsysco.nl/adsysco/regiweb/-/blob"
    FILE_PATH=$(git ls-files --full-name "$1")
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    GITLAB_URL="${HTTPS_URL%.git}/$CURRENT_BRANCH/$FILE_PATH"

    echo $GITLAB_URL | pbcopy
}

function giturldev {
    HTTPS_URL="https://git.adsysco.nl/adsysco/regiweb/-/blob"
    FILE_PATH=$(git ls-files --full-name "$1")
    CURRENT_BRANCH=development

    GITLAB_URL="${HTTPS_URL%.git}/$CURRENT_BRANCH/$FILE_PATH"

    echo $GITLAB_URL | pbcopy
}

function stopwatch {
        start=$(date +%s)
        while true; do
            time="$(($(date +%s) - $start))"
            printf '%s\r' "$(date -u -d "@$time" +%H:%M:%S)"
        done
}
