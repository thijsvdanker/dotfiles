function restoredb() {
    if [ -n "$1" ]
    then
        FILENAME=$1
    else
        FILENAME=demoDEMO
    fi
    if [ -n "$2" ]
    then
        DBNAME=$2
    else
        DBNAME=devDEMO
    fi

    /Users/thijs/Workspace/adsysco/haven/haven db restore ~/Workspace/adsysco/haven/services/mssql/backups/$FILENAME.bak $DBNAME
}

